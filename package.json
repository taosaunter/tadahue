{
  "name": "color-palette",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Color palette generator — Tailwind-style scales and color schemes",
  "author": "Taosaunter",
  "homepage": "https://github.com/taosaunter/color-palette",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:prod": "pnpm build && electron .",
    "electron:build": "vite build && electron-builder",
    "test": "node --test src/*.test.ts",
    "verify:theme": "node scripts/verify-theme.mjs",
    "lint:fix": "eslint . --fix"
  },
  "build": {
    "appId": "com.emi.colorpalette",
    "productName": "Color Palette",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*.mjs",
      "electron/**/*.cjs",
      "electron/**/*.html",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics"
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "culori": "^4.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^43.7.5",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1"
  }
}
