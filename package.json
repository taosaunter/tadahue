{
  "name": "tadahue",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "description": "A desktop color toolkit for creating harmonious palettes, generating color scales, extracting colors from images, previewing light and dark themes, and exporting CSS, Tailwind, or JSON.",
  "license": "MIT",
  "author": "Taosaunter",
  "homepage": "https://github.com/taosaunter/tadahue",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "biome check .",
    "preview": "vite preview",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:prod": "pnpm build && electron .",
    "electron:build": "vite build && electron-builder",
    "test": "node --test --test-isolation=none \"src/**/*.test.ts\" \"electron/**/*.test.mjs\"",
    "verify:theme": "node scripts/verify-theme.mjs",
    "lint:fix": "biome check --write ."
  },
  "build": {
    "appId": "com.taosaunter.tadahue",
    "productName": "TadaHue",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*.mjs",
      "electron/**/*.cjs",
      "electron/**/*.html",
      "!electron/**/*.test.mjs",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "assets/icon-512x512.png",
        "to": "tadahue.png"
      }
    ],
    "linux": {
      "target": ["AppImage"],
      "category": "Graphics",
      "icon": "assets/icon-512x512.png",
      "syncDesktopName": true
    },
    "win": {
      "target": ["portable", "nsis"],
      "icon": "assets/icon-256x256.ico"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "assets/icon-512x512.icns"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-sans-tc": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@homebridge/dbus-native": "0.7.9",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "colorthief": "^3.5.0",
    "culori": "^4.0.2",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^43.8.0",
    "electron-builder": "^26.15.3",
    "shadcn": "^4.22.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  },
  "desktopName": "com.taosaunter.tadahue.desktop"
}
