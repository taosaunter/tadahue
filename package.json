{
  "name": "tadahue",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A desktop color toolkit for creating harmonious palettes, generating color scales, extracting colors from images, previewing light and dark themes, and exporting CSS, Tailwind, or JSON.",
  "license": "MIT",
  "author": "Taosaunter",
  "homepage": "https://github.com/taosaunter/tadahue",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "node scripts/electron-dev.mjs",
    "electron:prod": "pnpm build && electron .",
    "electron:build": "vite build && electron-builder",
    "test": "node --test --test-isolation=none \"src/**/*.test.ts\" \"electron/**/*.test.mjs\"",
    "verify:theme": "node scripts/verify-theme.mjs",
    "lint:fix": "eslint . --fix"
  },
  "build": {
    "appId": "com.taosaunter.tadahue",
    "productName": "TadaHue",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*.mjs",
      "electron/**/*.cjs",
      "electron/**/*.html",
      "!electron/**/*.test.mjs",
      "package.json",
      "LICENSE",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "assets/icon-512x512.png",
        "to": "tadahue.png"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics",
      "icon": "assets/icon-512x512.png",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon-256x256.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon-512x512.icns"
    }
  },
  "dependencies": {
    "@homebridge/dbus-native": "0.7.9",
    "@tailwindcss/vite": "^4.3.3",
    "colorthief": "^3.5.0",
    "culori": "^4.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^43.7.5",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1"
  },
  "desktopName": "com.taosaunter.tadahue.desktop"
}
